\newcommand{\codeheader}[2]{
	{\par\noindent\footnotesize{\textbf{#1:} #2\par}}
}

\ifdefined\colormode
  \usemintedstyle{borland}
\else
  \usemintedstyle{bw}
\fi

\setminted{
	fontsize=\footnotesize,
	tabsize=2,
	breaklines,
	frame=topline,
	framesep=2mm
}

\DeclareCaptionFormat{mListing}{%
	{\large{\ifthenelse{\boolean{hasdescription}}{\textbf{#3}}{#3}}}
	\ifthenelse{\boolean{hasdescription}}{\codeheader{Descripción}{\@defdescription}}{}
	\ifthenelse{\boolean{hasusage}}{\codeheader{Uso}{\@defusage}}{}
	\ifthenelse{\boolean{hasmemory}}{\codeheader{Memoria}{\@defmemory}}{}
	\ifthenelse{\boolean{hastime}}{\codeheader{Complejidad}{\@deftime}}{}
	\ifthenelse{\boolean{hasdependencies}}{\codeheader{Requiere}{\@defdependencies}}{}
	\vspace{-9pt} \tiny \hfill \@rightcaption
	%\vspace{-5pt}
}

\newenvironment{mycode}[2]{
	\captionsetup{
		type=listing,
		justification=justified, % Select the justification for captions
		singlelinecheck=off, % Default behavior is to center single-line captions
		format=mListing,
		%skip=0pt,
		parskip=3pt,
		%font={stretch=.5},
	}
	\ifthenelse{\boolean{hasdescription}}{
 		\addcontentsline{toc}{section}{\protect#1}
	 	\sectionmark{#1}\phantom{}
	}{}
	\caption{#1\label{code:#2}}
}{}

\setmintedinline{
	texcomments,
	escapeinside=``
}

