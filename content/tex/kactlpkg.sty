\newcommand{\maketeampage}{
	\pagestyle{empty}
	\setcounter{page}{0}
	\begin{center}
		\strut % Magic
		\vspace{3cm}\\
		\begin{minipage}{0.45\textwidth}
			\centering
			\includegraphics[height=2cm]{\@unilogo}
		\end{minipage}%
		\begin{minipage}{0.45\textwidth}
			\centering
			\includegraphics[height=2cm]{logo2}
		\end{minipage}\\
		\vspace{1cm}
		{\fontsize{25}{30}\selectfont \@unilong\\}
		{\fontsize{60}{60}\selectfont \@teamname\\}
		\vspace{0.5cm}
		{\huge \@teammembers\\}
		\vfill
		{\fontsize{21}{25}\selectfont \@contestname}\\
		\vspace{0.5cm}
